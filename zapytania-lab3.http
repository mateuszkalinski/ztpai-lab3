@baseUrl = http://localhost:3000/api

# Przed testami: npx knex seed:run  (ID zaczynają się od 1)
# Seed: 3 budynki (C bez sal), 6 sal, 6 rezerwacji (1 trwa teraz, 1 anulowana)

############################################
# ZADANIE 2 - budynki i sale (Knex)
############################################

### wszystkie budynki
GET {{baseUrl}}/buildings

### jeden budynek
GET {{baseUrl}}/buildings/1

### budynek nie istnieje -> 404
GET {{baseUrl}}/buildings/999

### nowy budynek -> 201 (dostanie ID 4)
POST {{baseUrl}}/buildings
Content-Type: application/json

{
  "name": "Budynek D - Mechanika",
  "address": "ul. Kampusowa 22, Kraków"
}

### duplikat nazwy budynku -> 409 UNIQUE_VIOLATION
POST {{baseUrl}}/buildings
Content-Type: application/json

{
  "name": "Budynek A - Informatyka",
  "address": "ul. Lea 114, Kraków"
}

### budynek - błędy walidacji -> 400
POST {{baseUrl}}/buildings
Content-Type: application/json

{
  "name": "X",
  "city": "Kraków"
}

### nowa sala w budynku C -> 201
POST {{baseUrl}}/rooms
Content-Type: application/json

{
  "buildingId": 3,
  "name": "C001",
  "capacity": 25
}

### sala w nieistniejącym budynku -> 404
POST {{baseUrl}}/rooms
Content-Type: application/json

{
  "buildingId": 999,
  "name": "X001",
  "capacity": 25
}

### duplikat nazwy sali w tym samym budynku -> 409
POST {{baseUrl}}/rooms
Content-Type: application/json

{
  "buildingId": 1,
  "name": "A101",
  "capacity": 20
}

### ta sama nazwa w innym budynku -> 201
POST {{baseUrl}}/rooms
Content-Type: application/json

{
  "buildingId": 2,
  "name": "A101",
  "capacity": 20
}

### wszystkie sale
GET {{baseUrl}}/rooms

### wszystkie rezerwacje
GET {{baseUrl}}/reservations

### nowa rezerwacja -> 201 (do sprawdzenia, czy przetrwa restart)
POST {{baseUrl}}/reservations
Content-Type: application/json

{
  "roomId": 3,
  "reservedBy": "Mateusz Kaliński",
  "participants": 20,
  "startTime": "2026-12-10T09:00:00+01:00",
  "endTime": "2026-12-10T10:30:00+01:00"
}

### po restarcie servera - rezerwacja nadal jest
GET {{baseUrl}}/reservations/7

############################################
# ZADANIE 3 - relacje i JOIN bez N+1
############################################
# Przed testami: npx knex seed:run

### sala razem z budynkiem
GET {{baseUrl}}/rooms/3

### wszystkie sale z budynkami
GET {{baseUrl}}/rooms

### sale budynku A
GET {{baseUrl}}/buildings/1/rooms

### budynek bez sal -> []
GET {{baseUrl}}/buildings/3/rooms

### nieistniejący budynek -> 404
GET {{baseUrl}}/buildings/999/rooms

### budynki z liczbą sal (Budynek C -> roomsCount: 0)
GET {{baseUrl}}/buildings

### jeden budynek z liczbą sal
GET {{baseUrl}}/buildings/2

### rezerwacja z salą i budynkiem
GET {{baseUrl}}/reservations/2

### lista rezerwacji w tym samym formacie
GET {{baseUrl}}/reservations

############################################
# ZADANIE 4 - pagination, filtrowanie, sortowanie
############################################
# Przed testami: node scripts/set-reservations.js 20
# (seed + 14 dodatkowych rezerwacji = 20)

### domyślnie
GET {{baseUrl}}/reservations

### sala 1, tylko CONFIRMED, od najpóźniejszej
GET {{baseUrl}}/reservations?roomId=1&status=CONFIRMED&sort=-startTime

### budynek B, strona 2 po 3 rezerwacje
GET {{baseUrl}}/reservations?buildingId=2&page=2&limit=3

### najwięcej uczestników na górze, strona 2 po 5
GET {{baseUrl}}/reservations?sort=-participants&limit=5&page=2

### tylko anulowane, sortowanie po dacie utworzenia
GET {{baseUrl}}/reservations?status=CANCELLED&sort=createdAt

### rezerwacja 10:00-12:00 do testu przedziałów -> 201
POST {{baseUrl}}/reservations
Content-Type: application/json

{
  "roomId": 3,
  "reservedBy": "Mateusz Kaliński",
  "participants": 15,
  "startTime": "2026-12-15T10:00:00Z",
  "endTime": "2026-12-15T12:00:00Z"
}

### from=11:00 to=11:30 -> rezerwacja 10:00-12:00 jest widoczna (nakłada się)
GET {{baseUrl}}/reservations?roomId=3&from=2026-12-15T11:00:00Z&to=2026-12-15T11:30:00Z

### from=12:00 to=13:00 -> pusto (tylko się styka, [from, to) półotwarty)
GET {{baseUrl}}/reservations?roomId=3&from=2026-12-15T12:00:00Z&to=2026-12-15T13:00:00Z

### strona poza zakresem -> 200 i pusta tablica data
GET {{baseUrl}}/reservations?page=99

### from >= to -> 400
GET {{baseUrl}}/reservations?from=2026-12-15T12:00:00Z&to=2026-12-15T10:00:00Z

### nieznane sortowanie -> 400 (whitelista)
GET {{baseUrl}}/reservations?sort=reservedBy

### limit ponad 100 -> 400
GET {{baseUrl}}/reservations?limit=500
